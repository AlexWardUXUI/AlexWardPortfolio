---
/** Organism: CaseHeader. Eyebrow plus display title opening every case study. */
import type { CaseHeaderProps } from '../../types/schema';
import Heading from '../atoms/Heading.astro';
import Text from '../atoms/Text.astro';

type Props = CaseHeaderProps;

const { eyebrow, title } = Astro.props;
---

<header class="case-header">
  <Text style="eyebrow" color="muted">{eyebrow}</Text>
  <Heading level={1} style="display" color="display">{title}</Heading>
</header>

<style>
  .case-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }
  @media (max-width: 899px) {
    .case-header :global(h1) {
      font-size: clamp(40px, 9vw, 72px);
      letter-spacing: -0.04em;
    }
  }
  @media (max-width: 599px) {
    .case-header :global(p) {
      font-size: var(--font-size-lg);
    }
  }
</style>
