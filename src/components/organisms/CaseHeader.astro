---
/** Organism: CaseHeader. Eyebrow plus display title opening every case study. */
import type { CaseHeaderProps } from '../../types/schema';
import Heading from '../atoms/Heading.astro';
import Text from '../atoms/Text.astro';

type Props = CaseHeaderProps;

const { eyebrow, title } = Astro.props;
---

<header class="case-header">
  <Text style="lead" color="muted">{eyebrow}</Text>
  <Heading level={1} style="display" color="display">{title}</Heading>
</header>

<style>
  .case-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }
</style>
