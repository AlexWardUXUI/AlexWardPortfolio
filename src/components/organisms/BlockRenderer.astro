---
/**
 * Organism: BlockRenderer
 * Turns the case study Block[] schema into components. Adding a block type means:
 * 1) extend Block in src/types/schema.ts, 2) add a branch here. TypeScript's
 * exhaustive check below fails the build if a type is left unhandled.
 */
import type { BlockRendererProps } from '../../types/schema';
import Heading from '../atoms/Heading.astro';
import Text from '../atoms/Text.astro';
import RichText from '../atoms/RichText.astro';
import List from '../molecules/List.astro';
import Figure from '../molecules/Figure.astro';
import FigurePair from '../molecules/FigurePair.astro';
import Banner from '../molecules/Banner.astro';
import MetaRow from '../molecules/MetaRow.astro';
import Gallery from './Gallery.astro';

type Props = BlockRendererProps;

const { blocks, headingStyle } = Astro.props;
const h2Style = headingStyle === 'bold' ? 'heading-md' : 'heading-md-alt';
const h2Color = headingStyle === 'bold' ? 'heading' : 'display';

/** Compile-time exhaustiveness: `block` narrows to `never` once every Block type is handled. */
function assertNever(x: never): never {
  throw new Error(`Unhandled block type: ${JSON.stringify(x)}`);
}
---

<div class="blocks">
  {blocks.map((block) => {
    switch (block.type) {
      case 'heading':
        return block.level === 2 ? (
          <Heading level={2} style={h2Style} color={h2Color} class="block-heading block-heading--2">{block.text}</Heading>
        ) : (
          <Heading level={3} style="heading-sm" color="emphasis" class="block-heading">{block.text}</Heading>
        );
      case 'paragraph':
        return <Text color="secondary"><RichText content={block.text} /></Text>;
      case 'list':
        return <List items={block.items} tone={block.tone} />;
      case 'figure': {
        const { type: _t, ...figure } = block;
        return <Figure {...figure} />;
      }
      case 'figurePair':
        return <FigurePair images={block.images} />;
      case 'gallery': {
        const { type: _t, ...gallery } = block;
        return <Gallery {...gallery} />;
      }
      case 'banner':
        return <Banner title={block.title} />;
      case 'meta':
        return <Text style="caption" color="tertiary">{block.text}</Text>;
      case 'metaRow':
        return <MetaRow start={block.start} end={block.end} />;
      case 'columns':
        return (
          <div class="columns">
            {block.columns.map((col) => <Astro.self blocks={col} headingStyle={headingStyle} />)}
          </div>
        );
      default:
        return assertNever(block);
    }
  })}
</div>

<style>
  .blocks {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    min-width: 0;
  }
  /* Pull body content closer to the heading that introduces it */
  .blocks > :global(.block-heading + *) {
    margin-top: calc(var(--space-12) * -1);
  }
  .blocks > :global(.block-heading--2) {
    margin-top: var(--space-4);
  }
  .columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: start;
  }
  @media (max-width: 899px) {
    .columns {
      grid-template-columns: 1fr;
      gap: var(--space-32);
    }
  }
</style>
