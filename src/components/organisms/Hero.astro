---
/** Organism: Hero. Headline and intro beside an elevated square image. */
import type { HeroProps } from '../../types/schema';
import Heading from '../atoms/Heading.astro';
import Text from '../atoms/Text.astro';
import Image from '../atoms/Image.astro';

type Props = HeroProps;

const { title, intro, image } = Astro.props;
---

<section class="hero">
  <div class="hero__text">
    <Heading level={1} style="heading-lg" color="primary">{title}</Heading>
    <Text style="lead" color="emphasis">{intro}</Text>
  </div>
  <div class="hero__media">
    <Image {...image} loading="eager" />
  </div>
</section>

<style>
  .hero {
    min-height: var(--size-hero-min-height);
    padding: var(--space-120) var(--space-60) var(--space-64) var(--size-hero-offset);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-32);
    background: var(--gradient-hero);
  }
  .hero__text {
    width: var(--size-hero-text);
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }
  .hero__media {
    width: var(--size-hero-media);
    aspect-ratio: 1 / 1;
    flex: 0 0 auto;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: var(--shadow-elevated);
  }

  /* xl */
  @media (max-width: 1279px) {
    .hero {
      padding: var(--space-120) var(--space-40) var(--space-64);
      justify-content: center;
      gap: var(--space-64);
    }
    .hero__media {
      width: min(var(--size-hero-media), 45vw);
    }
  }
  /* md */
  @media (max-width: 899px) {
    .hero {
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
      padding: var(--space-120) var(--space-24) var(--space-56);
      gap: var(--space-40);
    }
    .hero__text,
    .hero__media {
      width: 100%;
      max-width: var(--size-hero-media);
      margin: 0 auto;
    }
  }
  /* sm */
  @media (max-width: 599px) {
    .hero :global(h1) {
      font-size: 28px;
    }
    .hero :global(p) {
      font-size: 20px;
    }
  }
</style>
