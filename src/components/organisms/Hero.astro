---
/** Organism: Hero. Headline and intro beside an elevated square image. */
import type { HeroProps } from '../../types/schema';
import Heading from '../atoms/Heading.astro';
import Text from '../atoms/Text.astro';
import Image from '../atoms/Image.astro';

type Props = HeroProps;

const { title, intro, image } = Astro.props;
---

<section class="hero">
  <div class="hero__text">
    <Heading level={1} style="display" color="primary">{title}</Heading>
    <Text style="lead" color="emphasis">{intro}</Text>
  </div>
  <div class="hero__media">
    <Image {...image} loading="eager" />
  </div>
</section>

<style>
  /* Side by side from 1100px, centred in size.hero-width */
  .hero {
    --hero-inset: max(var(--space-40), calc((100% - var(--size-hero-width)) / 2));
    min-height: var(--size-hero-min-height);
    padding: var(--space-120) var(--hero-inset) var(--space-64);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-48);
  }
  .hero__text {
    flex: 0 1 var(--size-hero-text);
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }
  .hero__media {
    width: min(var(--size-hero-media), 40vw);
    aspect-ratio: 1 / 1;
    flex: 0 0 auto;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: var(--shadow-elevation-3);
  }

  /* Below 1100px: stack, text first, in a centred content-width column */
  @media (max-width: 1099px) {
    .hero {
      --hero-inset: max(var(--space-40), calc((100% - var(--size-content-width)) / 2));
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
      padding-bottom: var(--space-56);
      gap: var(--space-40);
    }
    .hero__text {
      flex: none;
    }
    .hero__media {
      width: min(100%, var(--size-hero-media));
    }
  }
  @media (max-width: 599px) {
    .hero {
      --hero-inset: var(--space-24);
      padding-top: var(--space-120);
    }
  }
</style>
