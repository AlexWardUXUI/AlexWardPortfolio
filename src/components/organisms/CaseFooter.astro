---
/** Organism: CaseFooter. Case study name, a short prompt and a contact Button. */
import type { CaseFooterProps } from '../../types/schema';
import Text from '../atoms/Text.astro';
import Button from '../atoms/Button.astro';

type Props = CaseFooterProps;

const { label, prompt, cta } = Astro.props;
---

<footer class="case-footer">
  <Text as="span" style="label" color="secondary">{label}</Text>
  <div class="case-footer__cta">
    <Text as="span" style="label" color="secondary">{prompt}</Text>
    <Button {...cta} />
  </div>
</footer>

<style>
  .case-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-16);
    padding-top: var(--space-40);
  }
  .case-footer__cta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-12);
  }
</style>
