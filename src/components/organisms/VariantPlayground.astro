---
/**
 * Organism: VariantPlayground
 * Switches between ProjectCard variants and shows the typed props that produce
 * each one. CSS only, no client JavaScript: visually hidden radio inputs sit before
 * the controls and panels, and the general sibling combinator (~) shows the panel
 * that matches the checked input. Works in every browser. Up to 4 variants.
 */
import type { VariantPlaygroundProps } from '../../types/schema';
import ProjectCard from './ProjectCard.astro';
import CodeBlock from '../molecules/CodeBlock.astro';

type Props = VariantPlaygroundProps;

const { name, variants } = Astro.props;
const shown = variants.slice(0, 4);
const idFor = (id: string) => `${name}-${id}`;

function toSource(card: (typeof shown)[number]['card']): string {
  return `const card: ProjectCardProps = ${JSON.stringify(card, null, 2).replace(/"([a-zA-Z]+)":/g, '$1:')};`;
}
---

<div class="playground">
  {shown.map((v, i) => (
    <input class="playground__input" type="radio" name={name} id={idFor(v.id)} value={v.id} checked={i === 0} />
  ))}

  <div class="playground__bar">
    <span class="playground__legend type-caption text-muted" id={`${name}-legend`}>Switch variant</span>
    <div class="playground__controls" role="radiogroup" aria-labelledby={`${name}-legend`}>
      {shown.map((v) => (
        <label class="seg type-label" for={idFor(v.id)}>{v.label}</label>
      ))}
    </div>
  </div>

  <div class="playground__stage">
    {shown.map((v) => (
      <div class="playground__panel">
        <div class="playground__card">
          <ProjectCard {...v.card} />
        </div>
        <CodeBlock label="src/data/projects.ts" code={toSource(v.card)} />
      </div>
    ))}
  </div>
</div>

<style>
  .playground {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }

  /* Visually hidden but focusable, so arrow keys move between variants */
  .playground__input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .playground__controls {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-surface-default);
    width: fit-content;
    max-width: 100%;
  }
  .playground__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-12);
  }
  .playground__legend {
    text-transform: uppercase;
    letter-spacing: var(--font-letter-spacing-wide);
  }
  .seg {
    padding: var(--space-6) var(--space-12);
    border-radius: var(--radius-xs);
    color: var(--color-text-secondary);
    cursor: pointer;
    user-select: none;
  }
  .seg:hover {
    color: var(--color-text-primary);
  }

  .playground__panel {
    display: none;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-24);
    align-items: start;
  }

  /* Checked input n: highlight label n and show panel n */
  .playground__input:nth-of-type(1):checked ~ .playground__bar .seg:nth-of-type(1),
  .playground__input:nth-of-type(2):checked ~ .playground__bar .seg:nth-of-type(2),
  .playground__input:nth-of-type(3):checked ~ .playground__bar .seg:nth-of-type(3),
  .playground__input:nth-of-type(4):checked ~ .playground__bar .seg:nth-of-type(4) {
    background: var(--color-text-primary);
    color: var(--color-text-inverse);
  }
  .playground__input:nth-of-type(1):focus-visible ~ .playground__bar .seg:nth-of-type(1),
  .playground__input:nth-of-type(2):focus-visible ~ .playground__bar .seg:nth-of-type(2),
  .playground__input:nth-of-type(3):focus-visible ~ .playground__bar .seg:nth-of-type(3),
  .playground__input:nth-of-type(4):focus-visible ~ .playground__bar .seg:nth-of-type(4) {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
  }
  .playground__input:nth-of-type(1):checked ~ .playground__stage .playground__panel:nth-child(1),
  .playground__input:nth-of-type(2):checked ~ .playground__stage .playground__panel:nth-child(2),
  .playground__input:nth-of-type(3):checked ~ .playground__stage .playground__panel:nth-child(3),
  .playground__input:nth-of-type(4):checked ~ .playground__stage .playground__panel:nth-child(4) {
    display: grid;
  }

  .playground__card {
    max-width: 680px;
  }
  @media (max-width: 899px) {
    .playground__panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
