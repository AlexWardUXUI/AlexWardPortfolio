---
/** Organism: Navbar. Fixed top bar: brand (name and tagline) plus a list of nav Links. */
import type { NavbarProps } from '../../types/schema';
import Link from '../atoms/Link.astro';

type Props = NavbarProps;

const { brand, links } = Astro.props;
---

<header class="navbar">
  <a class="navbar__brand type-brand text-primary" href={brand.href}>
    <strong>{brand.name} |</strong><span class="navbar__tagline"> {brand.tagline}</span>
  </a>
  <nav aria-label="Primary">
    <ul class="navbar__links">
      {links.map((l) => <li><Link href={l.href} external={l.external} variant="nav">{l.label}</Link></li>)}
    </ul>
  </nav>
</header>

<style>
  .navbar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--size-nav-height);
    padding: var(--space-24);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-24);
    background: var(--color-surface-default);
  }
  .navbar__brand {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .navbar__links {
    display: flex;
    gap: var(--space-24);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 599px) {
    .navbar {
      padding: var(--space-16);
    }
    .navbar__tagline {
      display: none;
    }
    .navbar__links {
      gap: var(--space-16);
    }
  }
</style>
