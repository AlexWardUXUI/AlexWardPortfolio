---
/**
 * Atom: Image
 * Fills its container. Fit is explicit so cropping is a design decision, not an accident.
 * Alt text is required; decorative images keep their alt in data but are hidden from screen readers.
 */
import type { ImageProps } from '../../types/schema';

type Props = ImageProps;

const { src, alt, decorative = false, width, height, fit = 'cover', loading = 'lazy', class: className } = Astro.props;

if (!alt.trim()) {
  throw new Error(`Image "${src}" has no alt text. Describe the image, and add decorative: true if it only repeats nearby text.`);
}
---

<img
  src={src}
  alt={decorative ? '' : alt}
  aria-hidden={decorative ? 'true' : undefined}
  width={width}
  height={height}
  loading={loading}
  decoding="async"
  class:list={['image', `image--${fit}`, className]}
/>

<style>
  .image {
    width: 100%;
    height: 100%;
  }
  .image--cover {
    object-fit: cover;
  }
  .image--contain {
    object-fit: contain;
  }
</style>
