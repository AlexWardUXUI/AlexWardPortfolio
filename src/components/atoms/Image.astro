---
/**
 * Atom: Image
 * Fills its container. Fit is explicit so cropping is a design decision, not an accident.
 */
import type { ImageProps } from '../../types/schema';

type Props = ImageProps;

const { src, alt, width, height, fit = 'cover', loading = 'lazy', class: className } = Astro.props;
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding="async"
  class:list={['image', `image--${fit}`, className]}
/>

<style>
  .image {
    width: 100%;
    height: 100%;
  }
  .image--cover {
    object-fit: cover;
  }
  .image--contain {
    object-fit: contain;
  }
</style>
