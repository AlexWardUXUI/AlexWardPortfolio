---
/**
 * Atom: Chip
 * Translucent tool or topic tag that sits over imagery. Optional 20px icon.
 */
import type { ChipProps } from '../../types/schema';

type Props = ChipProps;

const { label, icon, iconFit = 'cover' } = Astro.props;
---

<span class="chip type-caption">
  {icon && <img class:list={['chip__icon', `chip__icon--${iconFit}`]} src={icon.src} alt={icon.decorative ? '' : icon.alt} aria-hidden={icon.decorative ? 'true' : undefined} width="20" height="20" />}
  {label}
</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-6) var(--space-8);
    border-radius: var(--radius-sm);
    background: var(--color-surface-overlay);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    box-shadow: var(--shadow-chip);
    color: var(--color-text-inverse);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .chip__icon {
    width: var(--size-icon-sm);
    height: var(--size-icon-sm);
    border-radius: var(--radius-xs);
  }
  .chip__icon--cover {
    object-fit: cover;
  }
  .chip__icon--contain {
    object-fit: contain;
  }
</style>
