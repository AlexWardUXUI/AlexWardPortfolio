---
/**
 * Atom: Icon. Simple 20px line icons drawn in currentColor. Always decorative
 * (hidden from screen readers): the text next to them carries the meaning.
 */
import type { IconProps } from '../../types/schema';

type Props = IconProps;

const { name, class: className } = Astro.props;

const paths: Record<IconProps['name'], string> = {
  menu: 'M3 5.5h14M3 10h14M3 14.5h14',
  work: 'M3.5 3.5h5v5h-5zM11.5 3.5h5v5h-5zM3.5 11.5h5v5h-5zM11.5 11.5h5v5h-5z',
  system: 'M10 2.8 17 6.5 10 10.2 3 6.5zM3 10l7 3.7 7-3.7M3 13.5l7 3.7 7-3.7',
  home: 'M3 9 10 3l7 6M5 7.5V17h10V7.5M8.5 17v-4.5h3V17',
  message: 'M3.5 4.5h13v9h-7l-4 3v-3h-2z',
  external: 'M8 4.5H4.5v11h11V12M11.5 3.5h5v5M16.5 3.5l-7 7',
};
---

<svg class:list={['icon', className]} viewBox="0 0 20 20" aria-hidden="true" focusable="false">
  <path d={paths[name]} />
</svg>

<style>
  .icon {
    flex: none;
    width: var(--size-icon-sm);
    height: var(--size-icon-sm);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
