---
/**
 * Atom: Pill
 * Solid secondary-colour badge for promoting an item, e.g. "Highlighted work".
 */
import type { PillProps } from '../../types/schema';

type Props = PillProps;

const { label } = Astro.props;
---

<span class="pill type-label-tight">{label}</span>

<style>
  .pill {
    flex: 0 0 auto;
    padding: var(--space-8);
    border-radius: var(--radius-sm);
    background: var(--color-secondary-default);
    color: var(--color-text-inverse);
    white-space: nowrap;
  }
</style>
