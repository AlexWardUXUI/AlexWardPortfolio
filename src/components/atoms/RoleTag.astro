---
/**
 * Atom: RoleTag
 * Muted label naming a role or discipline. Siblings are divided by RoleList.
 */
import type { RoleTagProps } from '../../types/schema';

type Props = RoleTagProps;

const { label } = Astro.props;
---

<span class="role type-label-tight">{label}</span>

<style>
  .role {
    padding: var(--space-8) var(--space-10);
    color: var(--role-text);
  }
</style>
