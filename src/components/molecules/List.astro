---
/** Molecule: List. Bulleted body-text list; items accept RichText. */
import type { ListProps } from '../../types/schema';
import RichText from '../atoms/RichText.astro';

type Props = ListProps;

const { items, tone = 'default' } = Astro.props;
---

<ul class:list={['list type-body', tone === 'strong' ? 'text-list' : 'text-secondary']}>
  {items.map((item) => <li><RichText content={item} /></li>)}
</ul>

<style>
  .list {
    padding-left: var(--space-24);
  }
</style>
