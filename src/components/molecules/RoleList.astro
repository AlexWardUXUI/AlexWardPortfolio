---
/** Molecule: RoleList. Muted role or discipline labels separated by a subtle divider. */
import type { RoleListProps } from '../../types/schema';

type Props = RoleListProps;

const { roles } = Astro.props;
---

<ul class="role-list" aria-label="Roles">
  {roles.map((role) => <li class="role type-label-tight">{role}</li>)}
</ul>

<style>
  .role-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .role {
    padding: var(--space-8) var(--space-10);
    color: var(--color-text-muted);
  }
  .role + .role {
    border-left: 1px solid var(--color-border-subtle);
  }
</style>
