---
/** Molecule: FigurePair. Two contained images side by side; stacks on phones. */
import type { ImageAsset } from '../../types/schema';
import Figure from './Figure.astro';

interface Props {
  images: [ImageAsset, ImageAsset];
}

const { images } = Astro.props;
---

<div class="figure-pair">
  {images.map((image) => <Figure image={image} fit="contain" aspect="445 / 363" />)}
</div>

<style>
  .figure-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
  }
  @media (max-width: 599px) {
    .figure-pair {
      grid-template-columns: 1fr;
    }
  }
</style>
