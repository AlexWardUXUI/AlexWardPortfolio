---
/** Molecule: CardMedia. Fixed-height card image with chips pinned bottom-left. */
import type { CardMediaProps } from '../../types/schema';
import Image from '../atoms/Image.astro';
import ChipGroup from './ChipGroup.astro';

type Props = CardMediaProps;

const { image, chips = [] } = Astro.props;
---

<div class="card-media">
  <Image {...image} />
  {chips.length > 0 && (
    <div class="card-media__chips">
      <ChipGroup chips={chips} />
    </div>
  )}
</div>

<style>
  .card-media {
    position: relative;
    height: var(--card-media-height);
    border-radius: var(--card-radius) var(--card-radius) var(--card-media-radius-inner) var(--card-media-radius-inner);
    overflow: hidden;
  }
  .card-media__chips {
    position: absolute;
    left: var(--space-20);
    right: var(--space-20);
    bottom: var(--space-12);
  }
  @media (max-width: 599px) {
    .card-media {
      height: 240px;
    }
  }
</style>
