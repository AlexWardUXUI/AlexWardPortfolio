---
/** Page: Case study. One static route per MDX file in src/content/case-studies. */
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import CaseStudyLayout from '../layouts/CaseStudyLayout.astro';

export const getStaticPaths = (async () => {
  const studies = await getCollection('caseStudies');
  return studies.map((entry: CollectionEntry<'caseStudies'>) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<'caseStudies'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<CaseStudyLayout study={entry.data}>
  <Content />
</CaseStudyLayout>
