{
  "$description": "Tier 2: semantic tokens. Named by purpose, aliased to primitives. Components consume these (or component tokens), never primitives.",
  "color": {
    "$type": "color",
    "primary": {
      "default": {
        "$value": "{color.blue.700}",
        "$description": "Primary action: links and focus ring."
      },
      "subtle": {
        "$value": "{color.blue.100}",
        "$description": "Low-emphasis primary tint: dividers."
      }
    },
    "secondary": {
      "default": {
        "$value": "{color.purple.600}",
        "$description": "Secondary accent: the Highlighted work pill."
      }
    },
    "status": {
      "pass": {
        "$value": "{color.green.800}"
      },
      "fail": {
        "$value": "{color.red.800}"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.neutral.950}",
        "$description": "Default ink: headings, brand, nav links. Safe on light glass."
      },
      "display": {
        "$value": "{color.navy.950}",
        "$description": "Case study titles."
      },
      "emphasis": {
        "$value": "{color.neutral.700}",
        "$description": "H3s, hero intro, connect strapline, controls on glass. Safe on light glass."
      },
      "secondary": {
        "$value": "{color.neutral.500}",
        "$description": "Body copy."
      },
      "muted": {
        "$value": "{color.neutral.400}",
        "$description": "Eyebrows, metadata, role tags."
      },
      "inverse": {
        "$value": "{color.neutral.0}"
      },
      "inverse-secondary": {
        "$value": "{color.neutral.75}"
      },
      "link": {
        "$value": "{color.primary.default}",
        "$description": "Inline links. Not used on glass: on glass, links use text.primary with a primary underline."
      }
    },
    "surface": {
      "page": {
        "$value": "{color.neutral.50}"
      },
      "default": {
        "$value": "{color.neutral.0}"
      },
      "sunken": {
        "$value": "{color.neutral.100}"
      },
      "inverse": {
        "$value": "{color.neutral.1000}"
      },
      "glass-light": {
        "$value": "{color.white.a80}",
        "$description": "Frosted light surface (nav, controls). Only text.primary and text.emphasis may sit on it."
      },
      "glass-light-solid": {
        "$value": "{color.neutral.0}",
        "$description": "Fallback when blur is unsupported or transparency is reduced."
      },
      "glass-dark": {
        "$value": "{color.ink.a78}",
        "$description": "Frosted dark surface over imagery (chips). Only text.inverse may sit on it."
      },
      "glass-dark-solid": {
        "$value": "{color.ink.950}",
        "$description": "Fallback for dark glass."
      },
      "glass-card-light": {
        "$value": "{color.white.a70}",
        "$description": "Frosted project card. Cards only sit on page surfaces, so it is measured over the darkest page backdrop pixel, not black. text.primary and text.secondary only."
      },
      "glass-card-dark": {
        "$value": "{color.ink.a90}",
        "$description": "Frosted highlighted card. Measured over pure white. text.inverse and text.inverse-secondary only."
      },
      "glass-button": {
        "$value": "{color.white.a90}",
        "$description": "Button fill over the brand gradient rim. Only text.primary sits on it: 16:1 at its darkest point."
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.primary.subtle}"
      },
      "default": {
        "$value": "{color.neutral.100}"
      },
      "focus": {
        "$value": "{color.primary.default}"
      },
      "glass-light": {
        "$value": "{color.white.a60}"
      },
      "glass-dark": {
        "$value": "{color.white.a16}"
      },
      "button-secondary": {
        "$value": "{color.ink.a28}",
        "$description": "Secondary button edge (decorative; the label identifies the button)."
      }
    },
    "backdrop": {
      "$description": "Decorative page backdrop (home page). Kept out of the content column so every text colour stays at 7:1 or above, checked pixel by pixel.",
      "glow-primary": {
        "$value": "{color.blue.a16}",
        "$description": "Blue glow, top left."
      },
      "glow-secondary": {
        "$value": "{color.purple.a14}",
        "$description": "Purple glow, top right."
      },
      "glow-primary-soft": {
        "$value": "{color.blue.a07}",
        "$description": "Blue glow, mid page left."
      },
      "glow-secondary-soft": {
        "$value": "{color.purple.a07}",
        "$description": "Purple glow, lower right."
      },
      "swirl": {
        "$value": "{color.blue.a20}",
        "$description": "Swirl contour lines in the side gutters (decorative)."
      }
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.4xl}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.line-height.snug}",
        "letterSpacing": "{font.letter-spacing.tighter}"
      },
      "$description": "Page and section titles, hero headline and stat numbers. Steps down to 32px below 600px (global.css)."
    },
    "heading-md": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.2xl}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.line-height.normal}",
        "letterSpacing": "{font.letter-spacing.snug}"
      },
      "$description": "Card titles and case study H2."
    },
    "heading-sm": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.lg}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.line-height.normal}",
        "letterSpacing": "{font.letter-spacing.none}"
      },
      "$description": "Case study H3."
    },
    "lead": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xl}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.normal}",
        "letterSpacing": "{font.letter-spacing.snug}"
      },
      "$description": "Hero intro, section intros, eyebrows above titles and the connect strapline. Steps down to 18px below 600px."
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.md}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.spacious}",
        "letterSpacing": "{font.letter-spacing.none}"
      },
      "$description": "Paragraphs and text links, including the nav."
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.sm}",
        "fontWeight": "{font.weight.medium}",
        "lineHeight": "{font.line-height.relaxed}",
        "letterSpacing": "{font.letter-spacing.snug}"
      },
      "$description": "Pills, nav brand, footer, meta rows and table headers."
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xs}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.spacious}",
        "letterSpacing": "{font.letter-spacing.none}"
      },
      "$description": "Chips and the skills line."
    },
    "code": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "{font.size.xs}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.relaxed}",
        "letterSpacing": "{font.letter-spacing.none}"
      },
      "$description": "Token names and code samples."
    }
  },
  "shadow": {
    "$type": "shadow",
    "elevation-0": {
      "$value": {
        "color": "{color.ink.a00}",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "Flat. Sits on the surface."
    },
    "elevation-1": {
      "$value": [
        {
          "color": "{color.ink.a06}",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        },
        {
          "color": "{color.ink.a08}",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "12px",
          "spread": "-4px"
        }
      ],
      "$description": "Raised: cards at rest, chips, controls."
    },
    "elevation-2": {
      "$value": [
        {
          "color": "{color.ink.a08}",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "0px"
        },
        {
          "color": "{color.ink.a18}",
          "offsetX": "0px",
          "offsetY": "18px",
          "blur": "36px",
          "spread": "-12px"
        }
      ],
      "$description": "Hover and focus: interactive cards lift to here."
    },
    "elevation-3": {
      "$value": [
        {
          "color": "{color.ink.a06}",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        },
        {
          "color": "{color.ink.a28}",
          "offsetX": "0px",
          "offsetY": "24px",
          "blur": "60px",
          "spread": "-24px"
        }
      ],
      "$description": "Floating: hero media."
    },
    "glass-highlight": {
      "$value": {
        "color": "{color.white.a60}",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "0px",
        "spread": "0px",
        "inset": true
      },
      "$description": "1px inner top highlight that gives glass its edge."
    }
  },
  "effect": {
    "$type": "dimension",
    "glass-blur-light": {
      "$value": "{blur.md}"
    },
    "glass-blur-dark": {
      "$value": "{blur.sm}"
    }
  },
  "motion": {
    "transition": {
      "$type": "transition",
      "base": {
        "$value": {
          "duration": "{duration.base}",
          "delay": "0ms",
          "timingFunction": "{easing.standard}"
        }
      }
    }
  },
  "gradient": {
    "$type": "gradient",
    "brand": {
      "$value": [
        {
          "color": "{color.primary.default}",
          "position": 0
        },
        {
          "color": "{color.secondary.default}",
          "position": 1
        }
      ],
      "$extensions": {
        "angle": "90deg"
      },
      "$description": "Blue to purple. Button rim and swirls (decorative, never behind text)."
    }
  },
  "opacity": {
    "$type": "number",
    "$description": "Strength of decorative layers.",
    "button-swirl": {
      "$value": 0.34,
      "$description": "Button swirls at rest."
    },
    "button-swirl-hover": {
      "$value": 0.6,
      "$description": "Button swirls on hover and focus."
    },
    "button-swirl-secondary": {
      "$value": 0,
      "$description": "Secondary button swirls at rest: hidden."
    },
    "button-swirl-secondary-hover": {
      "$value": 0.22,
      "$description": "Secondary button swirls on hover and focus."
    }
  }
}
