{
  "$description": "Tier 2: semantic tokens. Named by purpose, aliased to primitives. Components consume these (or component tokens), never primitives.",
  "color": {
    "$type": "color",
    "primary": {
      "default": {
        "$value": "{color.blue.600}",
        "$description": "Primary action: links, nav actions, focus ring."
      },
      "subtle": {
        "$value": "{color.blue.100}",
        "$description": "Low-emphasis primary tint: dividers."
      }
    },
    "secondary": {
      "default": {
        "$value": "{color.purple.500}",
        "$description": "Secondary accent: highlights such as the Highlighted work pill."
      }
    },
    "status": {
      "pass": {
        "$value": "{color.green.700}"
      },
      "fail": {
        "$value": "{color.red.700}"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.neutral.950}",
        "$description": "Default ink: headings, brand, hero."
      },
      "display": {
        "$value": "{color.navy.950}",
        "$description": "Case study titles."
      },
      "emphasis": {
        "$value": "{color.neutral.700}",
        "$description": "H3s, hero intro, connect strapline."
      },
      "secondary": {
        "$value": "{color.neutral.500}",
        "$description": "Body copy."
      },
      "muted": {
        "$value": "{color.neutral.400}",
        "$description": "Eyebrows, metadata, role tags."
      },
      "inverse": {
        "$value": "{color.neutral.0}"
      },
      "inverse-secondary": {
        "$value": "{color.neutral.75}"
      },
      "link": {
        "$value": "{color.primary.default}"
      }
    },
    "surface": {
      "page": {
        "$value": "{color.neutral.50}"
      },
      "default": {
        "$value": "{color.neutral.0}"
      },
      "sunken": {
        "$value": "{color.neutral.100}"
      },
      "inverse": {
        "$value": "{color.neutral.1000}"
      },
      "overlay": {
        "$value": "{color.grey.a60}",
        "$description": "Translucent surface over imagery (chips)."
      },
      "hero-start": {
        "$value": "{color.neutral.0}"
      },
      "hero-end": {
        "$value": "{color.neutral.25}"
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.primary.subtle}"
      },
      "default": {
        "$value": "{color.neutral.100}"
      },
      "focus": {
        "$value": "{color.primary.default}"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.6xl}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.line-height.snug}",
        "letterSpacing": "{font.letter-spacing.tightest}"
      },
      "$description": "Case study H1."
    },
    "heading-xl": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.4xl}",
        "fontWeight": "{font.weight.extrabold}",
        "lineHeight": "{font.line-height.snug}",
        "letterSpacing": "{font.letter-spacing.tighter}"
      },
      "$description": "Section titles."
    },
    "heading-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.3xl}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.line-height.snug}",
        "letterSpacing": "{font.letter-spacing.tight}"
      },
      "$description": "Hero headline."
    },
    "heading-md": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.2xl}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.line-height.normal}",
        "letterSpacing": "{font.letter-spacing.snug}"
      },
      "$description": "Card titles and case study H2. The only H2 style (the semibold navy variant and the gradient banner were retired)."
    },
    "heading-sm": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.lg}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{font.line-height.normal}",
        "letterSpacing": "{font.letter-spacing.none}"
      },
      "$description": "Case study H3."
    },
    "eyebrow": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.2xl}",
        "fontWeight": "{font.weight.medium}",
        "lineHeight": "{font.line-height.relaxed}",
        "letterSpacing": "{font.letter-spacing.snug}"
      }
    },
    "lead": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.2xl}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.snug}",
        "letterSpacing": "{font.letter-spacing.snug}"
      },
      "$description": "Hero intro."
    },
    "lead-sm": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xl}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.normal}",
        "letterSpacing": "{font.letter-spacing.snug}"
      },
      "$description": "Section intros, connect strapline."
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.md}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.spacious}",
        "letterSpacing": "{font.letter-spacing.none}"
      }
    },
    "nav-link": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.md}",
        "fontWeight": "{font.weight.medium}",
        "lineHeight": "{font.line-height.relaxed}",
        "letterSpacing": "{font.letter-spacing.none}"
      }
    },
    "brand": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.md}",
        "fontWeight": "{font.weight.light}",
        "lineHeight": "{font.line-height.double}",
        "letterSpacing": "{font.letter-spacing.wide}"
      }
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.sm}",
        "fontWeight": "{font.weight.medium}",
        "lineHeight": "{font.line-height.relaxed}",
        "letterSpacing": "{font.letter-spacing.none}"
      },
      "$description": "Footer, meta rows, table headers."
    },
    "label-tight": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.sm}",
        "fontWeight": "{font.weight.medium}",
        "lineHeight": "{font.line-height.relaxed}",
        "letterSpacing": "{font.letter-spacing.snug}"
      },
      "$description": "Pills and role tags."
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xs}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.spacious}",
        "letterSpacing": "{font.letter-spacing.none}"
      },
      "$description": "Chips and the skills line."
    },
    "code": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "{font.size.xs}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{font.line-height.relaxed}",
        "letterSpacing": "{font.letter-spacing.none}"
      },
      "$description": "Token names and code samples."
    }
  },
  "shadow": {
    "$type": "shadow",
    "chip": {
      "$value": [
        {
          "color": "{color.black.a18}",
          "offsetX": "0px",
          "offsetY": "0.6px",
          "blur": "0.6px",
          "spread": "-1.25px"
        },
        {
          "color": "{color.black.a16}",
          "offsetX": "0px",
          "offsetY": "2.3px",
          "blur": "2.3px",
          "spread": "-2.5px"
        },
        {
          "color": "{color.black.a06}",
          "offsetX": "0px",
          "offsetY": "10px",
          "blur": "10px",
          "spread": "-3.75px"
        }
      ]
    },
    "elevated": {
      "$value": [
        {
          "color": "{color.ink.a06}",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        },
        {
          "color": "{color.ink.a28}",
          "offsetX": "0px",
          "offsetY": "24px",
          "blur": "60px",
          "spread": "-24px"
        }
      ],
      "$description": "Hero media."
    },
    "hover": {
      "$value": [
        {
          "color": "{color.ink.a04}",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "0px"
        },
        {
          "color": "{color.ink.a18}",
          "offsetX": "0px",
          "offsetY": "16px",
          "blur": "36px",
          "spread": "-12px"
        }
      ],
      "$description": "Interactive card hover and focus."
    },
    "none": {
      "$value": {
        "color": "{color.ink.a00}",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "0px"
      }
    }
  },
  "gradient": {
    "$type": "gradient",
    "hero": {
      "$value": [
        {
          "color": "{color.surface.hero-start}",
          "position": 0
        },
        {
          "color": "{color.surface.hero-end}",
          "position": 1
        }
      ],
      "$extensions": {
        "angle": "180deg"
      }
    }
  },
  "motion": {
    "transition": {
      "$type": "transition",
      "base": {
        "$value": {
          "duration": "{duration.base}",
          "delay": "0ms",
          "timingFunction": "{easing.standard}"
        }
      }
    }
  }
}
